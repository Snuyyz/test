Q.estab_dissent = 0;
Q.mod_strength = 20;
Q.mod_dissent = 5;
Q.labor_strength = 10;
Q.labor_dissent = 5;

// election model: historical baseline + player-driven modifier
Q.pop_mod = 0;       // accumulated deviation from the historical popular vote
Q.dem_pop = 47;      // last two-party national vote share (D)
Q.house_d = 201;
Q.senate_d = 55;     // including independents caucusing with Dems
Q.white_house = 'D';
Q.president = 'Obama';
Q.vp = 'Biden';
