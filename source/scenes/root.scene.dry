Q.funds = 6;        // fundraising, in "units" (roughly $50M each)

// the state of the republic
Q.stability = 72;   // democratic stability 0-100
Q.enthusiasm = 50;  // base enthusiasm 0-100
Q.unity = 60;       // party unity 0-100
Q.maga = 0;         // strength of the populist right inside the GOP 0-100
Q.far_right = 15;   // organized right-wing extremism 0-100
Q.far_left = 10;    // strength of the insurgent / radical left 0-100
Q.media_trust = 40; // trust in institutions & media

// factions
Q.prog_strength = 25;
Q.prog_dissent = 10;
