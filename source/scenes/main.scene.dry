title: Next month
is-hand: true
max-cards: 4
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 month';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Q.advisor_action_timer + ' months';
}
if (Q.shuffle_leadership_timer <= 0) {
    Q.pinnedCardsDescription += '\n- a reshuffle is available.';
} else if (Q.shuffle_leadership_timer == 1) {
    Q.pinnedCardsDescription += '\n- next reshuffle in 1 month';
} else {
    Q.pinnedCardsDescription += '\n- next reshuffle in ' + Q.shuffle_leadership_timer + ' months.';
}
Q.last_time_updated = Q.time;
!}
on-display: {!
if (!document.getElementById('news_tab')) {
    var button = document.createElement('button');
    button.style.backgroundColor = '#dddddd';
    button.className = 'tab_button';
    button.id = 'news_tab';
    button.textContent = 'View Right-Wing News';
    button.onclick = function () {
        toggleNews();
    };
    var contentDiv = document.getElementById('content');
    contentDiv.appendChild(button);
    const elements = document.querySelectorAll('.rightnews');
    let hasTextContent = false;
    elements.forEach(function (element) {
        if (element.textContent.trim() !== '') {
            hasTextContent = true;
        }
    });
    if (hasTextContent) {
        button.style.backgroundColor = 'rgba(255, 0, 0, 0.5)';
    } else {
        button.style.backgroundColor = '#dddddd';
    }
    document.querySelectorAll('p').forEach(p => {
        if (!p.textContent.trim()) {
            p.remove();
        }
    });
}
const boxes = document.querySelectorAll('.scrollable-box');
if (boxes.length >= 2) {
    boxes[1].remove();
}
!}

# Here, the main deck will be displayed. Clicking on a deck draws a card into your hand. Clicking on a card plays that card (one action = one month).

{!<div class="scrollable-box">!}

{!<p class="both">!}[? if year = 2014 and month = 1: It is January 2014. The <span style="color: #1a5fb4;">**Democrats**</span> hold the White House and the Senate; the <span style="color: #c01c28;">**GOP**</span> control the House. The Affordable Care Act's coverage provisions have just taken effect, the recovery from the Great Recession is uneven, and anger at institutions is building on both left and right. The next test is the midterms in November. Your job: keep the party together, win elections, and keep American democracy intact through whatever comes next. ?]{!</p>!}

{!<p class="both">!}[? if dem_president = 0 and year = 2017 and month = 1 and just_inaugurated: A new <span style="color: #c01c28;">**GOP**</span> administration takes office. The <span style="color: #1a5fb4;">**Democrats**</span> are in opposition, and the question is how to resist without breaking the guardrails that protect everyone. ?]{!</p>!}

{!<p class="both">!}[? if dem_president = 1 and just_inaugurated and year >= 2017: A new <span style="color: #1a5fb4;">**Democrats**</span> administration takes office. Governing will test the party's factions as much as the opposition does. ?]{!</p>!}

{!<p class="both">!}[? if democracy_score < 40 and not game_lost: Alarm bells are ringing: independent monitors warn that American democracy is in serious danger of backsliding. ?]{!</p>!}

{!<p class="both">!}[? if democracy_score >= 85 and year >= 2018: Civil society and institutions appear robust; political scientists describe American democracy as resilient despite the polarization. ?]{!</p>!}

{!<p class="rightnews">!}[? if maga_strength >= 40 and maga_strength < 60: The <span style="color: #b5651d;">**MAGA**</span> movement dominates Republican primaries and rallies, reshaping the party in its image. ?]{!</p>!}

{!<p class="rightnews">!}[? if maga_strength >= 60: The <span style="color: #b5651d;">**MAGA**</span> movement has effectively captured the Republican Party; dissenters within the party are being primaried or silenced. ?]{!</p>!}

{!<p class="rightnews">!}[? if maga_strength < 25: Establishment Republicans hold the party firmly; the insurgent right is restless but fragmented. ?]{!</p>!}

{!<p class="rightnews">!}[? if farright_strength >= 20: Far-right militias and online extremist networks are growing, with rising reports of intimidation of election workers and officials. ?]{!</p>!}

{!<p class="other">!}[? if farleft_strength >= 25: Left-wing protest movements and third-party groups are gaining strength, accusing the Democrats of betraying their base. ?]{!</p>!}

{!<p class="both">!}[? if unemployed >= 10: Unemployment stands at [+ unemployed_2 +] percent; millions are out of work. ?]{!</p>!}

{!<p class="both">!}[? if inflation >= 6: Inflation is running at [+ inflation_2 +] percent, squeezing household budgets and dominating political debate. ?]{!</p>!}

{!<p class="both">!}[? if months_to_election <= 3 and months_to_election >= 0 and not (year = 2014 and month = 1): Election season: the generic ballot and battleground polls show Democrats [+ dem_votes_d +] percent, Republicans [+ gop_votes_d +] percent. ?]{!</p>!}

{!<p class="other">!}[? if year = 2014 and month = 2: The Winter Olympics open in Sochi, Russia. ?]{!</p>!}

{!<p class="other">!}[? if year = 2014 and month = 3: Russia annexes Crimea following a disputed referendum; the West responds with sanctions. ?]{!</p>!}

{!<p class="other">!}[? if year = 2014 and month = 4: The Supreme Court strikes down aggregate limits on campaign contributions in McCutcheon v. FEC. ?]{!</p>!}

{!<p class="other">!}[? if year = 2014 and month = 6: ISIS seizes Mosul and proclaims a caliphate across parts of Iraq and Syria. ?]{!</p>!}

{!<p class="other">!}[? if year = 2014 and month = 7: Malaysia Airlines Flight 17 is shot down over eastern Ukraine. ?]{!</p>!}

{!<p class="other">!}[? if year = 2014 and month = 8: Protests erupt in Ferguson, Missouri, after a police shooting. ?]{!</p>!}

{!<p class="other">!}[? if year = 2014 and month = 9: Scotland votes to remain in the United Kingdom. ?]{!</p>!}

{!<p class="other">!}[? if year = 2014 and month = 10: A case of Ebola is diagnosed in Dallas, setting off a national scare. ?]{!</p>!}

{!<p class="other">!}[? if year = 2014 and month = 12: The United States and Cuba announce steps toward restoring diplomatic relations. ?]{!</p>!}

{!<p class="other">!}[? if year = 2015 and month = 1: Gunmen attack the offices of Charlie Hebdo in Paris. ?]{!</p>!}

{!<p class="other">!}[? if year = 2015 and month = 6: A white supremacist murders nine worshippers at a historic Black church in Charleston, South Carolina. ?]{!</p>!}

{!<p class="other">!}[? if year = 2015 and month = 7: Iran and six world powers reach a nuclear agreement in Vienna. ?]{!</p>!}

{!<p class="other">!}[? if year = 2015 and month = 9: A refugee crisis grips Europe; Pope Francis visits the United States. ?]{!</p>!}

{!<p class="other">!}[? if year = 2015 and month = 11: Coordinated attacks kill 130 people in Paris. ?]{!</p>!}

{!<p class="other">!}[? if year = 2015 and month = 12: Nearly 200 nations adopt the Paris climate agreement; the Federal Reserve raises interest rates for the first time since 2006. ?]{!</p>!}

{!<p class="other">!}[? if year = 2016 and month = 2: Supreme Court Justice Antonin Scalia dies, leaving a vacancy in an election year. ?]{!</p>!}

{!<p class="other">!}[? if year = 2016 and month = 6: A gunman kills 49 people at an Orlando nightclub. Days later, British voters choose to leave the European Union. ?]{!</p>!}

{!<p class="other">!}[? if year = 2016 and month = 8: The Summer Olympics open in Rio de Janeiro. ?]{!</p>!}

{!<p class="other">!}[? if year = 2017 and month = 8: A white-supremacist rally in Charlottesville, Virginia, turns deadly; Hurricane Harvey devastates the Texas coast. ?]{!</p>!}

{!<p class="other">!}[? if year = 2017 and month = 9: Hurricane Maria devastates Puerto Rico. ?]{!</p>!}

{!<p class="other">!}[? if year = 2017 and month = 10: A gunman kills 58 people at a Las Vegas concert. The #MeToo movement spreads after allegations against a Hollywood producer. ?]{!</p>!}

{!<p class="other">!}[? if year = 2018 and month = 2: A school shooting in Parkland, Florida, leaves 17 dead and mobilizes student activists. ?]{!</p>!}

{!<p class="other">!}[? if year = 2018 and month = 10: A gunman kills eleven worshippers at a Pittsburgh synagogue. ?]{!</p>!}

{!<p class="other">!}[? if year = 2019 and month = 3: A gunman kills 51 worshippers at two mosques in Christchurch, New Zealand. ?]{!</p>!}

{!<p class="other">!}[? if year = 2019 and month = 6: Mass protests erupt in Hong Kong. ?]{!</p>!}

{!<p class="other">!}[? if year = 2019 and month = 12: Chinese authorities report a cluster of pneumonia cases in Wuhan caused by a novel coronavirus. ?]{!</p>!}

{!<p class="other">!}[? if year = 2020 and month = 1: The novel coronavirus spreads across Asia; the first US case is confirmed. ?]{!</p>!}

{!<p class="other">!}[? if year = 2020 and month = 8: A massive explosion devastates the port of Beirut. ?]{!</p>!}

{!<p class="other">!}[? if year = 2020 and month = 12: The first COVID-19 vaccines receive emergency authorization in the United States. ?]{!</p>!}

{!<p class="other">!}[? if year = 2021 and month = 3: The Ever Given blocks the Suez Canal as vaccination campaigns accelerate. ?]{!</p>!}

{!<p class="other">!}[? if year = 2021 and month = 8: Kabul falls to the Taliban as the last Western forces withdraw from Afghanistan. ?]{!</p>!}

{!<p class="other">!}[? if year = 2021 and month = 11: The Omicron variant is identified; world leaders gather for the COP26 climate summit. ?]{!</p>!}

{!<p class="other">!}[? if year = 2022 and month = 2: Russia launches a full-scale invasion of Ukraine. ?]{!</p>!}

{!<p class="other">!}[? if year = 2022 and month = 9: Queen Elizabeth II dies after seventy years on the throne. ?]{!</p>!}

{!<p class="other">!}[? if year = 2022 and month = 11: OpenAI releases ChatGPT, setting off a race in artificial intelligence. ?]{!</p>!}

{!<p class="other">!}[? if year = 2023 and month = 3: Silicon Valley Bank collapses, shaking confidence in regional banks. ?]{!</p>!}

{!<p class="other">!}[? if year = 2023 and month = 6: The Wagner Group briefly mutinies against the Russian military leadership. ?]{!</p>!}

{!<p class="other">!}[? if year = 2023 and month = 10: Hamas attacks Israel on October 7, and Israel launches a war in Gaza. ?]{!</p>!}

{!<p class="other">!}[? if year = 2024 and month = 7: The Summer Olympics open in Paris. ?]{!</p>!}

{!<p class="other">!}[? if year = 2024 and month = 12: The Assad regime falls in Syria after a rebel offensive. ?]{!</p>!}

{!<p class="other">!}[? if year = 2025 and month = 1: Wildfires devastate Los Angeles County. ?]{!</p>!}

{!<p class="other">!}[? if year = 2025 and month = 5: Cardinal Robert Prevost is elected Pope Leo XIV, the first pope from the United States. ?]{!</p>!}

{!<p class="other">!}[? if year = 2025 and month = 6: Israel and Iran exchange strikes in a twelve-day war. ?]{!</p>!}

{!<p class="other">!}[? if year = 2026 and month = 2: The Winter Olympics open in Milan and Cortina d'Ampezzo. ?]{!</p>!}

{!<p class="other">!}[? if year = 2026 and month = 6: The FIFA World Cup opens across the United States, Canada, and Mexico. ?]{!</p>!}

{!<p class="other">!}[? if year = 2026 and month = 7: The United States marks the 250th anniversary of the Declaration of Independence. ?]{!</p>!}

{!</div>!}

